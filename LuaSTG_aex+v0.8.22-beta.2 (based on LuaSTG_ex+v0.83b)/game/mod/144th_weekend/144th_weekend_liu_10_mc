4,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"local tmp = 0\r\nlocal _spd,_a = spd,math.deg(ran:Float(-PI,PI)) * -1\r\nif self.moveLimit then\r\n\tlocal x, y = self.x, self.y\r\n\tlocal p = self.moveLimit\r\n\tfor i = 1,time do\r\n\t\t_spd = func(spd,0,min(i/time,1),mode)\r\n\t\tx = x + _spd * cos(_a)\r\n\t\ty = y + _spd * sin(_a)\r\n\tend\r\n\tfor _ = 1, 34 do\r\n\t\t_a = math.deg(ran:Float(-PI,PI)) * -1\r\n\t\tx, y = 0, 0\r\n\t\tfor i = 1,time do\r\n\t\t\t_spd = func(spd,0,min(i/time,1),mode)\r\n\t\t\tx = x + _spd * cos(_a)\r\n\t\t\ty = y + _spd * sin(_a)\r\n\t\tend\r\n\t\tif (x >= p[1] and x <= p[2] and y >= p[3] and y <= p[4]) then break end\r\n\tend\r\n\tself.x = min(max(self.x + spd * cos(_a), p[1]), p[2])\r\n\tself.y = min(max(self.y + spd * sin(_a), p[3]), p[4])\r\n\tfor i = 1,time do\r\n\t\t_spd = func(spd,0,min(i/time,1),mode)\r\n\t\ttask._Wait(1)\r\n\t\tself.x = min(max(self.x + _spd * cos(_a), p[1]), p[2])\r\n\t\tself.y = min(max(self.y + _spd * sin(_a), p[3]), p[4])\r\n\tend\r\nend","EditWindow":"code"}],"AttributeCount":1}
