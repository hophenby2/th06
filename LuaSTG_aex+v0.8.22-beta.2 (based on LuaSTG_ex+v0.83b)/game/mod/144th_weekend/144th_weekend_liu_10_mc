7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"local extend_rate = 1 + 8 / 60\r\nlocal alpha = min(b.sc_ring_alpha or 144, 144)\r\nlocal exr1 = -0.5\r\nlocal bold = 1\r\nlocal main_radius = 160\r\nlocal timer, rov, cut, flag = b.timer, 4, 48, 1\r\nlocal pause = ext.pause_menu\r\nif pause and pause.IsKilled and pause:IsKilled() then\r\n\tpause = false\r\nend\r\nlocal ringx = b._sc_ring_x or b.x\r\nlocal ringy = b._sc_ring_y or b.y\r\nif not pause then\r\n\tlocal minspeed = b._sc_ring_minspeed or 0.5\r\n\tlocal ratespeed = b._sc_ring_ratespeed or 0.08\r\n\tlocal speed = Dist(ringx, ringy, b.x, b.y)\r\n\tlocal angle = Angle(ringx, ringy, b.x, b.y)\r\n\tspeed = min(speed, max(speed * ratespeed, minspeed))\r\n\tringx = ringx + speed * cos(angle)\r\n\tringy = ringy + speed * sin(angle)\r\nend\r\nb._sc_ring_x = ringx\r\nb._sc_ring_y = ringy\r\nif not b.__is_waiting and b.__draw_sc_ring then\r\n\tfor i = 1, 16 do\r\n\t\tSetImageState('bossring1' .. i, 'mul+add', Color(alpha, 255, 255, 255))\r\n\tend\r\n\tif timer < 90 then\r\n\t\tif b.fxr and b.fxg and b.fxb then\r\n\t\t\tlocal of = 1 - timer / 180\r\n\t\t\tfor i = 1, 16 do\r\n\t\t\t\tSetImageState('bossring2' .. i, 'mul+add',\r\n\t\t\t\t\tColor(1.9 * alpha, b.fxr * of, b.fxg * of, b.fxb * of))\r\n            end\r\n\t\telse\r\n\t\t\tfor i = 1, 16 do\r\n\t\t\t\tSetImageState('bossring2' .. i, 'mul+add',\r\n\t\t\t\t\tColor(alpha, 255, 255, 255))\r\n\t\t\tend\r\n\t\tend\r\n\t\tmisc.RenderRing('bossring1', ringx, ringy,\r\n\t\t\ttimer * (main_radius / 90) + main_radius * 1.5 * sin(timer * 2) + 14 + exr1 + bold,\r\n\t\t\ttimer * (main_radius / 90) + main_radius * 1.5 * sin(timer * 2) - 2 + exr1,\r\n\t\t\t-b.ani * rov, cut, 16)\r\n\t\tmisc.RenderRing('bossring2', ringx, ringy,\r\n\t\t\t90 + ((main_radius - 90) / 90) * timer + 4,\r\n\t\t\t-main_radius + (1 - cos(timer) ^ 2) * (main_radius * 2 - 12) - bold,\r\n\t\t\tb.ani * rov, cut, 16)--white\r\n\telse\r\n\t\tif b.fxr and b.fxg and b.fxb then\r\n\t\t\tfor i = 1, 16 do\r\n\t\t\t\tSetImageState('bossring2' .. i, 'mul+add',\r\n\t\t\t\t\tColor(1.9 * alpha, b.fxr / 2, b.fxg / 2, b.fxb / 2))\r\n\t\t\tend\r\n\t\telse\r\n\t\t\tfor i = 1, 16 do\r\n\t\t\t\tSetImageState('bossring2' .. i, 'mul+add',\r\n\t\t\t\t\tColor(alpha, 255, 255, 255))\r\n\t\t\tend\r\n\t\tend\r\n\t\tlocal t = b.t3 * extend_rate --多给点收缩时间,符卡环最终半径不要为0\r\n\t\tmisc.RenderRing('bossring1', ringx, ringy,\r\n\t\t\t(t - timer * 1.08) / (t - 90) * main_radius + 14 + exr1 + bold,\r\n\t\t\t(t - timer * 1.08) / (t - 90) * main_radius - 2 + exr1,\r\n\t\t\t-b.ani * rov, cut, 16)\r\n\t\tmisc.RenderRing('bossring2', ringx, ringy,\r\n\t\t\t(t - timer) / (t - 90) * main_radius + 4,\r\n\t\t\t(t - timer) / (t - 90) * main_radius - 12 - bold,\r\n\t\t\tb.ani * rov, cut, 16)--white\r\n\tend\r\nend","EditWindow":"code"}],"AttributeCount":1}
